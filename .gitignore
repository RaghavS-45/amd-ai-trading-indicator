# .gitignore
.venv/
__pycache__/
*.pyc
*.pyo
.DS_Store

# API keys — NEVER commit
.env
*.env

# Data files (large; re-downloadable)
data/*.parquet
data/*.csv

# Keep the checksum so it can be committed and verified
!data/*.sha256

# Trained models (large; regenerated by run_all.py)
models/*.pkl
models/*.joblib
# except the frozen live model (5 KB): the deployed app needs it, and it fixes what was tested
!models/live_model.joblib

# Notebook checkpoints
.ipynb_checkpoints/

# Live DB
app/signals.db

# Out-of-sample predictions (large; regenerated by run_all.py)
report/*.parquet

# Report output figures (regenerated)
report/*.png
report/*.pdf
